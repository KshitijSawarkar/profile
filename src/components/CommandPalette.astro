---
---

<!-- Floating Command Palette Toggle Trigger -->
<div class="fixed bottom-6 left-6 z-40">
  <button
    id="cmd-palette-toggle"
    class="flex items-center gap-2 px-3.5 py-2 rounded-xl bg-midnight-800/90 hover:bg-midnight-700 border border-violet-brand/50 text-xs font-mono text-lime-neon shadow-card-glow hover:shadow-glow-lime transition-all group hover:scale-105"
    title="Open Developer Terminal (Ctrl + K)"
  >
    <span class="w-2 h-2 rounded-full bg-lime-neon animate-pulse"></span>
    <span class="font-bold">CLI / Terminal</span>
    <kbd class="px-1.5 py-0.5 rounded bg-midnight-950 border border-midnight-600 text-[10px] text-slate-400 group-hover:text-slate-200">⌘K</kbd>
  </button>
</div>

<!-- Modal Overlay -->
<div
  id="cmd-palette-modal"
  class="fixed inset-0 z-50 bg-midnight-950/80 backdrop-blur-md flex items-center justify-center p-4 opacity-0 pointer-events-none transition-all duration-300"
>
  <div class="w-full max-w-2xl bg-midnight-900 border border-violet-brand/60 rounded-2xl shadow-glow-violet overflow-hidden flex flex-col max-h-[80vh]">
    <!-- Terminal Header Bar -->
    <div class="px-4 py-3 bg-midnight-950 border-b border-midnight-700 flex items-center justify-between font-mono text-xs text-slate-400">
      <div class="flex items-center gap-2">
        <span class="w-3 h-3 rounded-full bg-red-500/80 inline-block"></span>
        <span class="w-3 h-3 rounded-full bg-yellow-500/80 inline-block"></span>
        <span class="w-3 h-3 rounded-full bg-green-500/80 inline-block"></span>
        <span class="text-lime-neon font-bold ml-2">kshitij@sovereign-systems:~</span>
      </div>
      <div class="flex items-center gap-3">
        <span class="hidden sm:inline text-[11px] text-slate-500">Press ESC to exit</span>
        <button id="cmd-palette-close" class="hover:text-white transition-colors text-sm font-bold">&times;</button>
      </div>
    </div>

    <!-- Quick Shortcuts Bar -->
    <div class="px-4 py-2 bg-midnight-900/90 border-b border-midnight-800 flex items-center gap-2 overflow-x-auto text-[11px] font-mono text-slate-300">
      <span class="text-slate-500 shrink-0">Quick run:</span>
      <button class="quick-cmd px-2 py-0.5 rounded bg-midnight-800 hover:bg-violet-deep border border-midnight-700 text-lime-neon" data-cmd="help">help</button>
      <button class="quick-cmd px-2 py-0.5 rounded bg-midnight-800 hover:bg-violet-deep border border-midnight-700 text-slate-300" data-cmd="ieee">ieee</button>
      <button class="quick-cmd px-2 py-0.5 rounded bg-midnight-800 hover:bg-violet-deep border border-midnight-700 text-slate-300" data-cmd="experience">experience</button>
      <button class="quick-cmd px-2 py-0.5 rounded bg-midnight-800 hover:bg-violet-deep border border-midnight-700 text-slate-300" data-cmd="education">education</button>
      <button class="quick-cmd px-2 py-0.5 rounded bg-midnight-800 hover:bg-violet-deep border border-midnight-700 text-slate-300" data-cmd="contact">contact</button>
      <button class="quick-cmd px-2 py-0.5 rounded bg-midnight-800 hover:bg-violet-deep border border-midnight-700 text-pink-neon" data-cmd="sudo hire">sudo hire</button>
    </div>

    <!-- Terminal Output Area -->
    <div id="terminal-output" class="p-4 flex-1 overflow-y-auto font-mono text-xs text-slate-200 space-y-2 min-h-[220px]">
      <div class="text-slate-400">
        Welcome to <span class="text-lime-neon font-bold">Kshitij Sawarkar's Interactive Terminal</span> [v2.4.0].<br/>
        Type <span class="text-lime-neon font-semibold">'help'</span> to view available commands or click quick shortcuts above.
      </div>
    </div>

    <!-- Input Form -->
    <form id="terminal-form" class="p-3 bg-midnight-950 border-t border-midnight-700 flex items-center gap-2 font-mono text-xs">
      <span class="text-lime-neon font-bold">&gt;</span>
      <input
        type="text"
        id="terminal-input"
        autocomplete="off"
        placeholder="Type command (e.g. 'help', 'ieee', 'skills', 'contact')..."
        class="flex-1 bg-transparent text-white focus:outline-none placeholder-slate-600"
      />
      <button type="submit" class="px-3 py-1 rounded bg-violet-deep hover:bg-violet-brand border border-violet-brand text-xs font-bold text-white transition-colors">
        Run
      </button>
    </form>
  </div>
</div>

<script>
  const toggleBtn = document.getElementById('cmd-palette-toggle');
  const modal = document.getElementById('cmd-palette-modal');
  const closeBtn = document.getElementById('cmd-palette-close');
  const form = document.getElementById('terminal-form');
  const input = document.getElementById('terminal-input') as HTMLInputElement;
  const output = document.getElementById('terminal-output');

  function openTerminal() {
    modal?.classList.remove('opacity-0', 'pointer-events-none');
    modal?.classList.add('opacity-100');
    input?.focus();
  }

  function closeTerminal() {
    modal?.classList.remove('opacity-100');
    modal?.classList.add('opacity-0', 'pointer-events-none');
  }

  toggleBtn?.addEventListener('click', openTerminal);
  closeBtn?.addEventListener('click', closeTerminal);

  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeTerminal();
  });

  // Hotkey listener: Ctrl + K / Cmd + K and ESC
  window.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      if (modal?.classList.contains('opacity-0') || modal?.classList.contains('pointer-events-none')) {
        openTerminal();
      } else {
        closeTerminal();
      }
    }
    if (e.key === 'Escape') {
      closeTerminal();
    }
  });

  // Quick Command Buttons
  document.querySelectorAll('.quick-cmd').forEach(btn => {
    btn.addEventListener('click', () => {
      const cmd = btn.getAttribute('data-cmd');
      if (cmd) executeCommand(cmd);
    });
  });

  function printLine(content: string, isCommand = false) {
    if (!output) return;
    const div = document.createElement('div');
    if (isCommand) {
      div.className = 'text-lime-neon font-bold mt-2';
      div.innerHTML = `&gt; ${content}`;
    } else {
      div.className = 'text-slate-300 leading-relaxed';
      div.innerHTML = content;
    }
    output.appendChild(div);
    output.scrollTop = output.scrollHeight;
  }

  function executeCommand(rawCmd: string) {
    const cmd = rawCmd.trim().toLowerCase();
    if (!cmd) return;

    printLine(cmd, true);

    switch (cmd) {
      case 'help':
        printLine(`
          <div class="space-y-1 text-slate-300">
            <div><span class="text-lime-neon font-bold">experience</span> - View Wakefit, MNNIT GTA, AICTE & Sharon roles</div>
            <div><span class="text-lime-neon font-bold">education</span> - View M.Tech (MNNIT) & B.Tech (RCOEM) credentials</div>
            <div><span class="text-lime-neon font-bold">ieee</span> - Inspect IEEE Xplore Published Research (Doc ID: 10627276)</div>
            <div><span class="text-lime-neon font-bold">skills</span> - List Control Systems, Edge AI, Embedded & Cloud skills</div>
            <div><span class="text-lime-neon font-bold">ventures</span> - Discover cardsfinders.com, myuselessweb.com & live tools</div>
            <div><span class="text-lime-neon font-bold">contact</span> - Display direct phone, email, GitHub & LinkedIn</div>
            <div><span class="text-pink-neon font-bold">sudo hire</span> - Direct collaboration & high-priority message dispatch</div>
            <div><span class="text-slate-400 font-bold">clear</span> - Clear terminal screen</div>
          </div>
        `);
        break;

      case 'ieee':
      case 'paper':
      case 'research':
        printLine(`
          <div class="p-2.5 rounded bg-midnight-950 border border-lime-neon/40 text-slate-200">
            <span class="text-lime-neon font-bold">📄 IEEE Xplore Published Lead Author</span><br/>
            Title: Automated Edge Vision & Retail Checkout System<br/>
            Doc ID: <span class="text-yellow-400">10627276</span> &bull; Published: March 2026<br/>
            Key Milestone: INT8 Post-Training Quantization on Raspberry Pi with &lt;1% mAP loss.
          </div>
        `);
        const researchElem = document.getElementById('research-projects');
        if (researchElem) researchElem.scrollIntoView({ behavior: 'smooth' });
        break;

      case 'experience':
      case 'work':
        printLine(`
          <div class="space-y-1 text-slate-200">
            <div>&bull; <span class="text-lime-neon font-bold">Wakefit Innovations Ltd</span> (Aug 2026 – Present) - Systems & Automation Engineering Intern</div>
            <div>&bull; <span class="text-violet-300 font-bold">MNNIT Allahabad</span> (Aug 2025 – Present) - Graduate Teaching Assistant (100+ Students)</div>
            <div>&bull; <span class="text-slate-300 font-bold">Sharon Innovations</span> (Dec 2023 – Feb 2024) - IoT & Embedded Intern</div>
            <div>&bull; <span class="text-slate-300 font-bold">AICTE</span> (May 2023 – Jul 2023) - Cloud Infrastructure & MLOps Intern</div>
          </div>
        `);
        const expElem = document.getElementById('experience');
        if (expElem) expElem.scrollIntoView({ behavior: 'smooth' });
        break;

      case 'education':
        printLine(`
          <div class="space-y-1 text-slate-200">
            <div>🎓 <span class="text-lime-neon font-bold">M.Tech in Control & Instrumentation</span> &bull; MNNIT Allahabad (2025–2027)</div>
            <div>🎓 <span class="text-violet-300 font-bold">B.Tech in Electronics & Communication</span> &bull; RCOEM Nagpur (2020–2024)</div>
          </div>
        `);
        const eduElem = document.getElementById('education');
        if (eduElem) eduElem.scrollIntoView({ behavior: 'smooth' });
        break;

      case 'skills':
        printLine(`
          <div class="text-slate-200">
            <span class="text-lime-neon font-bold">Control & Robotics:</span> State-Space, HIL Calibration, ROS2, SLAM, Closed-Loop<br/>
            <span class="text-violet-300 font-bold">Hardware & Embedded:</span> ESP32, Raspberry Pi 5, Arduino, I2C/SPI/UART, ADC<br/>
            <span class="text-pink-neon font-bold">Edge AI:</span> YOLOv5, INT8 ONNX Quantization, SageMaker, OpenCV<br/>
            <span class="text-slate-300 font-bold">Cloud & Edge:</span> Multi-Agent Orchestration, AWS Lambda, Cloudflare Pages/Workers
          </div>
        `);
        const skillsElem = document.getElementById('skills');
        if (skillsElem) skillsElem.scrollIntoView({ behavior: 'smooth' });
        break;

      case 'ventures':
        printLine(`
          <div class="space-y-1 text-slate-200">
            <div>🚀 <span class="text-lime-neon font-bold">cardsfinders.com</span> - Global Edge Financial Tools Platform</div>
            <div>🌐 <span class="text-violet-300 font-bold">myuselessweb.com</span> - High-Traffic Edge Discovery (&lt;50ms TTFB)</div>
            <div>⚡ <span class="text-slate-300 font-bold">npl-automation.pages.dev</span> - Sub-50ms BOM Schema Transformation</div>
          </div>
        `);
        const ventElem = document.getElementById('ventures');
        if (ventElem) ventElem.scrollIntoView({ behavior: 'smooth' });
        break;

      case 'contact':
        printLine(`
          <div class="space-y-1 text-slate-200">
            <div>📞 Phone: <a href="tel:+919823252972" class="text-lime-neon font-bold hover:underline">+91 9823252972</a></div>
            <div>📧 Email: <a href="mailto:kshitijsawarkar333@gmail.com" class="text-lime-neon font-bold hover:underline">kshitijsawarkar333@gmail.com</a></div>
            <div>💼 LinkedIn: <a href="https://linkedin.com/in/kshitijas" target="_blank" class="text-blue-300 font-bold hover:underline">linkedin.com/in/kshitijas</a></div>
            <div>🐙 GitHub: <a href="https://github.com/KshitijSawarkar" target="_blank" class="text-violet-300 font-bold hover:underline">github.com/KshitijSawarkar</a></div>
          </div>
        `);
        const contElem = document.getElementById('contact');
        if (contElem) contElem.scrollIntoView({ behavior: 'smooth' });
        break;

      case 'sudo hire':
      case 'hire':
        printLine(`
          <div class="p-3 rounded-xl bg-violet-deep/60 border border-lime-neon text-slate-100">
            <span class="text-lime-neon font-bold">PERMISSION GRANTED:</span> Initiating direct recruitment protocol.<br/>
            Opening mailto draft to <span class="text-lime-neon">kshitijsawarkar333@gmail.com</span>...
          </div>
        `);
        if ((window as any).showToast) {
          (window as any).showToast("Direct contact initiated!");
        }
        setTimeout(() => {
          window.location.href = "mailto:kshitijsawarkar333@gmail.com?subject=Opportunity%20Discussion%20with%20Kshitij%20Sawarkar";
        }, 800);
        break;

      case 'clear':
        if (output) output.innerHTML = '';
        break;

      default:
        printLine(`
          <span class="text-pink-neon">Command not recognized: "${cmd}".</span> Type <span class="text-lime-neon font-bold">'help'</span> for a list of valid commands.
        `);
        break;
    }
  }

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (input) {
      executeCommand(input.value);
      input.value = '';
    }
  });
</script>
