---
const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<header class="sticky top-0 z-50 w-full border-b border-midnight-600/60 bg-midnight-900/90 backdrop-blur-md">
  <!-- Top Agent Protocol Banner -->
  <div class="w-full bg-midnight-950/90 border-b border-midnight-700/50 py-1 px-4 text-center font-mono text-[11px] text-slate-400 flex items-center justify-center gap-2">
    <span class="w-1.5 h-1.5 rounded-full bg-lime-neon animate-pulse"></span>
    <span class="text-slate-300">AI Agent Endpoints:</span>
    <a href={`${baseUrl}llms.txt`} target="_blank" class="text-lime-neon hover:underline font-semibold">/llms.txt</a>
    <span class="text-slate-600">&bull;</span>
    <a href={`${baseUrl}api/profile.json`} target="_blank" class="text-violet-300 hover:underline font-semibold">/api/profile.json</a>
  </div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
    <a href="#" class="flex items-center gap-2.5 group">
      <div class="w-8 h-8 rounded-lg bg-midnight-800 border border-violet-brand/50 flex items-center justify-center font-mono font-bold text-lime-neon text-sm group-hover:border-lime-neon transition-colors">
        KS
      </div>
      <div class="flex flex-col">
        <span class="font-bold text-white text-sm tracking-tight group-hover:text-lime-neon transition-colors">
          Kshitij Sawarkar
        </span>
        <span class="text-[11px] text-slate-400 font-mono">
          Applied AI & Systems Engineer
        </span>
      </div>
    </a>

    <nav class="hidden lg:flex items-center gap-6 text-xs font-mono text-slate-300 uppercase tracking-wider">
      <a href="#experience" class="hover:text-lime-neon transition-colors">Experience</a>
      <a href="#projects" class="hover:text-lime-neon transition-colors">Research & Deployments</a>
      <a href="#ventures" class="hover:text-lime-neon transition-colors">Ventures</a>
      <a href="#education" class="hover:text-lime-neon transition-colors">Education</a>
      <a href="#skills" class="hover:text-lime-neon transition-colors">4-Pillar Taxonomy</a>
      <a href="#contact" class="hover:text-lime-neon transition-colors">Contact</a>
    </nav>

    <div class="flex items-center gap-3">
      <a
        href="mailto:kshitijsawarkar333@gmail.com"
        class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg text-xs font-semibold text-midnight-950 bg-lime-neon hover:bg-lime-glow transition-all shadow-glow-lime"
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
        <span>Contact</span>
      </a>
    </div>
  </div>
</header>
