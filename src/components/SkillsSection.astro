---
const skillPillars = [
  {
    pillarNum: "01",
    title: "Field Commissioning & Robotics Integration",
    badge: "Field Operations & AMRs",
    skills: [
      "Robot Operating System 2 (ROS2)",
      "Embedded Linux",
      "AMRs/AGVs",
      "Sensor Fusion",
      "Microcontrollers (ESP32, ARM)",
      "Hardware-in-the-Loop (HIL) Validation"
    ]
  },
  {
    pillarNum: "02",
    title: "Edge AI & Computer Vision",
    badge: "Edge Inference",
    skills: [
      "YOLOv5",
      "OpenCV",
      "Post-Training Quantization (INT8)",
      "ONNX Runtime",
      "Raspberry Pi 5",
      "Low-Latency Inference"
    ]
  },
  {
    pillarNum: "03",
    title: "Customer Systems Integration & Automation",
    badge: "Deterministic Edge",
    skills: [
      "Deterministic Schema Engines",
      "Sub-50ms Edge Validation",
      "REST APIs",
      "Cloudflare Pages/Workers",
      "Pydantic v2",
      "Python",
      "TypeScript"
    ]
  },
  {
    pillarNum: "04",
    title: "Closed-Loop Control Theory",
    badge: "Stability & Actuation",
    skills: [
      "State-Space Modeling",
      "Closed-Loop Feedback Stability",
      "Root Locus",
      "Transfer Functions",
      "MATLAB/Simulink"
    ]
  }
];
---

<section id="skills" class="py-16 md:py-20 border-t border-midnight-600/50">
  <div class="max-w-5xl mx-auto px-4 sm:px-6">
    <!-- Header -->
    <div class="mb-10">
      <div class="text-xs font-mono text-lime-neon uppercase tracking-wider mb-2">
        04 / SYSTEMS TAXONOMY
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white font-display">
        4-Pillar Systems Taxonomy
      </h2>
      <p class="text-slate-400 mt-2 text-base">
        A deterministic engineering architecture bridging physical control theory, edge computer vision, and autonomous agent systems.
      </p>
    </div>

    <!-- 4-Pillar Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
      {skillPillars.map(pillar => (
        <div class="glass-panel p-6 rounded-2xl border border-midnight-600/80 hover:border-violet-brand/60 transition-all flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between gap-2 mb-3">
              <span class="text-xs font-mono font-bold text-lime-neon">
                Pillar {pillar.pillarNum}
              </span>
              <span class="text-[11px] font-mono text-violet-300 px-2 py-0.5 rounded bg-midnight-900 border border-violet-brand/40">
                {pillar.badge}
              </span>
            </div>

            <h3 class="text-lg font-bold text-white mb-4 pb-2 border-b border-midnight-700">
              {pillar.title}
            </h3>

            <div class="flex flex-wrap gap-2">
              {pillar.skills.map(skill => (
                <span class="px-2.5 py-1 rounded-lg text-xs font-mono bg-midnight-900/80 border border-midnight-700 text-slate-200">
                  {skill}
                </span>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
