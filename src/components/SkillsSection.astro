---
const skillPillars = [
  {
    pillarNum: "01",
    title: "Applied AI & Edge Vision",
    badge: "Edge Intelligence",
    skills: [
      "YOLOv5",
      "OpenCV",
      "INT8 Quantization",
      "ONNX Runtime",
      "Raspberry Pi",
      "ROS2"
    ]
  },
  {
    pillarNum: "02",
    title: "Autonomous Agent Systems",
    badge: "Deterministic AI",
    skills: [
      "Agent State Machines",
      "Model Context Protocol (MCP)",
      "LLM Failover Routing",
      "Pydantic v2 Guardrails"
    ]
  },
  {
    pillarNum: "03",
    title: "Systems Automation & Edge Web",
    badge: "High-Throughput",
    skills: [
      "Cloudflare Pages/Workers",
      "Astro.js",
      "Sub-50ms Schema Engines",
      "Python",
      "TypeScript"
    ]
  },
  {
    pillarNum: "04",
    title: "Control & Instrumentation",
    badge: "Control Systems",
    skills: [
      "Closed-Loop State Feedback",
      "State-Space Modeling",
      "HIL Testing",
      "MATLAB/Simulink"
    ]
  }
];
---

<section id="skills" class="py-16 md:py-20 border-t border-midnight-600/50">
  <div class="max-w-5xl mx-auto px-4 sm:px-6">
    <!-- Header -->
    <div class="mb-10">
      <div class="text-xs font-mono text-lime-neon uppercase tracking-wider mb-2">
        04 / SYSTEMS TAXONOMY
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white font-display">
        4-Pillar Systems Taxonomy
      </h2>
      <p class="text-slate-400 mt-2 text-base">
        A deterministic engineering architecture bridging physical control theory, edge computer vision, and autonomous agent systems.
      </p>
    </div>

    <!-- 4-Pillar Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
      {skillPillars.map(pillar => (
        <div class="glass-panel p-6 rounded-2xl border border-midnight-600/80 hover:border-violet-brand/60 transition-all flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between gap-2 mb-3">
              <span class="text-xs font-mono font-bold text-lime-neon">
                Pillar {pillar.pillarNum}
              </span>
              <span class="text-[11px] font-mono text-violet-300 px-2 py-0.5 rounded bg-midnight-900 border border-violet-brand/40">
                {pillar.badge}
              </span>
            </div>

            <h3 class="text-lg font-bold text-white mb-4 pb-2 border-b border-midnight-700">
              {pillar.title}
            </h3>

            <div class="flex flex-wrap gap-2">
              {pillar.skills.map(skill => (
                <span class="px-2.5 py-1 rounded-lg text-xs font-mono bg-midnight-900/80 border border-midnight-700 text-slate-200">
                  {skill}
                </span>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
