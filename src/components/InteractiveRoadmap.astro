              <path d="M 22,12 L 30,6 L 44,6 L 50,12 Z" fill="#c2ef4e" fill-opacity="0.85" />
              
              <!-- Headlights Beam Glow -->
              <polygon points="58,18 78,12 78,26 58,22" fill="url(#headlightGrad)" opacity="0.6" />
              <circle cx="58" cy="20" r="2.5" fill="#ffffff" />
            </svg>

            <!-- Headlight Beam Gradient definition -->
            <svg class="absolute w-0 h-0">
              <defs>
                <linearGradient id="headlightGrad" x1="0%" y1="50%" x2="100%" y2="50%">
                  <stop offset="0%" stop-color="#c2ef4e" stop-opacity="0.9" />
                  <stop offset="100%" stop-color="#c2ef4e" stop-opacity="0" />
                </linearGradient>
              </defs>
            </svg>
          </div>
        </div>
      </div>
    </div>

    <!-- Active Station Interactive Detail Card -->
    <div id="station-details-card" class="glass-panel p-6 sm:p-8 rounded-2xl border border-lime-neon/40 shadow-card-glow relative overflow-hidden transition-all duration-300">
      <!-- Subtle Background Ambient -->
      <div class="absolute top-0 right-0 w-80 h-80 bg-gradient-to-bl from-lime-neon/15 via-violet-brand/10 to-transparent blur-3xl pointer-events-none -z-10"></div>

      <div class="flex flex-col lg:flex-row lg:items-start justify-between gap-6">
        <!-- Station Meta -->
        <div class="flex-1">
          <div class="flex flex-wrap items-center gap-2.5 mb-2">
            <span id="card-station-tag" class="px-2.5 py-0.5 rounded text-xs font-mono font-bold bg-lime-neon text-midnight-950 shadow-sm">
              Station 1 of 7
            </span>
            <span id="card-category" class="text-xs font-mono text-violet-300 px-2 py-0.5 rounded bg-midnight-900 border border-violet-brand/40">
              Academic Foundation
            </span>
            <span id="card-year" class="text-xs font-mono text-slate-400">
              2020 – 2024
            </span>
          </div>

          <h3 id="card-title" class="text-2xl sm:text-3xl font-extrabold text-white font-display mb-1">
            B.Tech in Electronics & Communication Engineering
          </h3>
          <p id="card-subtitle" class="text-base text-lime-neon font-medium mb-3">
            Shri Ramdeobaba College of Engineering and Management (RCOEM) &bull; Nagpur
          </p>

          <p id="card-highlight" class="text-sm sm:text-base text-slate-200 leading-relaxed mb-4">
            Graduated with core specialization in Embedded Systems, Signal Processing, and Microcontrollers.
          </p>

          <!-- Bullet Points -->
          <ul id="card-bullets" class="space-y-2 mb-5">
            <li class="flex items-start gap-2 text-sm text-slate-300">
              <span class="w-1.5 h-1.5 rounded-full bg-lime-neon mt-2 shrink-0"></span>
              <span>Mastered embedded architectures, microcontrollers, and hardware-software interfacing.</span>
            </li>
            <li class="flex items-start gap-2 text-sm text-slate-300">
              <span class="w-1.5 h-1.5 rounded-full bg-lime-neon mt-2 shrink-0"></span>
              <span>Developed physical hardware prototypes with I2C, SPI, and UART communication protocols.</span>
            </li>
          </ul>

          <!-- Tech Pills -->
          <div id="card-pills" class="flex flex-wrap gap-1.5 pt-4 border-t border-midnight-600/50">
            <span class="px-2.5 py-0.5 rounded text-xs font-mono bg-midnight-900/80 border border-midnight-700 text-slate-300">Embedded C++</span>
            <span class="px-2.5 py-0.5 rounded text-xs font-mono bg-midnight-900/80 border border-midnight-700 text-slate-300">Microcontrollers</span>
            <span class="px-2.5 py-0.5 rounded text-xs font-mono bg-midnight-900/80 border border-midnight-700 text-slate-300">Signal Processing</span>
            <span class="px-2.5 py-0.5 rounded text-xs font-mono bg-midnight-900/80 border border-midnight-700 text-slate-300">RCOEM Nagpur</span>
          </div>
        </div>

        <!-- Quick Switcher Navigation Buttons -->
        <div class="flex lg:flex-col gap-2 shrink-0 justify-end">
          <button
            id="btn-prev-station"
            class="px-4 py-2.5 rounded-xl bg-midnight-900 hover:bg-midnight-800 border border-midnight-700 text-xs font-mono text-slate-300 hover:text-white transition-all flex items-center gap-1.5"
          >
            <span>&larr; Prev Stop</span>
          </button>
          <button
            id="btn-next-station"
            class="px-4 py-2.5 rounded-xl bg-violet-deep hover:bg-violet-brand border border-violet-brand text-xs font-mono font-bold text-lime-neon hover:text-white transition-all flex items-center gap-1.5"
          >
            <span>Next Stop &rarr;</span>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

