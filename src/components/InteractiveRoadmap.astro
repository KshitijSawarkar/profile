---

<section id="journey-roadmap" class="py-16 md:py-24 border-t border-midnight-600/50 relative overflow-hidden">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-lime-neon/15 text-lime-neon border border-lime-neon/30 text-xs font-mono mb-2">
          <span class="w-2 h-2 rounded-full bg-lime-neon animate-ping"></span>
          <span>INTERACTIVE JOURNEY HIGHWAY</span>
        </div>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-white font-display">
          From B.Tech to Forward Deployed Engineer
        </h2>
        <p class="text-slate-400 mt-2 text-sm sm:text-base max-w-2xl">
          Move your cursor across the destinations on the road — watch the car drive in real-time to inspect each career milestone.
        </p>
      </div>

      <!-- Controls: Tour mode / station indicator -->
      <div class="flex items-center gap-3 font-mono text-xs">
        <button
          id="btn-auto-tour"
          class="px-3.5 py-1.5 rounded-lg bg-midnight-800 hover:bg-violet-deep border border-violet-brand/50 text-lime-neon transition-all flex items-center gap-1.5"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span id="tour-btn-text">Auto Drive Tour</span>
        </button>
        <div class="px-3 py-1.5 rounded-lg bg-midnight-900 border border-midnight-700 text-slate-300">
          Station <span id="active-station-num" class="text-lime-neon font-bold">1</span> / 7
        </div>
      </div>
    </div>

    <!-- Interactive Road Highway Canvas Container -->
    <div class="relative w-full rounded-3xl bg-midnight-950 border border-midnight-700/80 p-4 sm:p-8 shadow-card-glow overflow-hidden mb-8">
      <!-- Background Highway Glow Grid -->
      <div class="absolute inset-0 bg-grid-pattern opacity-40 pointer-events-none"></div>

      <!-- Road SVG Track Layer -->
      <div class="relative w-full h-[320px] sm:h-[400px]">
        <svg
          class="w-full h-full absolute inset-0 overflow-visible"
          viewBox="0 0 1000 400"
          preserveAspectRatio="none"
        >
          <defs>
            <!-- Road Asphalt Gradient -->
            <linearGradient id="roadGrad" x1="0%" y1="0%" x2="100%" y2="0%">
              <stop offset="0%" stop-color="#150f23" />
              <stop offset="50%" stop-color="#1f1633" />
              <stop offset="100%" stop-color="#150f23" />
            </linearGradient>

            <!-- Glow Filters -->
            <filter id="neonLimeGlow" x="-20%" y="-20%" width="140%" height="140%">
              <feGaussianBlur stdDeviation="5" result="blur" />
              <feMerge>
                <feMergeNode in="blur" />
                <feMergeNode in="SourceGraphic" />
              </feMerge>
            </filter>
          </defs>

          <!-- Outer Road Bed with Glow -->
          <path
            d="M 60,320 C 180,320 180,160 260,160 C 340,160 340,320 420,320 C 500,320 500,140 580,140 C 660,140 660,310 740,310 C 820,310 820,150 880,150 C 940,150 940,260 970,260"
            fill="none"
            stroke="#2a1f45"
            stroke-width="56"
            stroke-linecap="round"
            stroke-linejoin="round"
          />

          <!-- Main Road Asphalt Base -->
          <path
            d="M 60,320 C 180,320 180,160 260,160 C 340,160 340,320 420,320 C 500,320 500,140 580,140 C 660,140 660,310 740,310 C 820,310 820,150 880,150 C 940,150 940,260 970,260"
            fill="none"
            stroke="#150f23"
            stroke-width="44"
            stroke-linecap="round"
            stroke-linejoin="round"
          />

          <!-- Road Shoulder Neon Glowing Lines -->
          <path
            d="M 60,320 C 180,320 180,160 260,160 C 340,160 340,320 420,320 C 500,320 500,140 580,140 C 660,140 660,310 740,310 C 820,310 820,150 880,150 C 940,150 940,260 970,260"
            fill="none"
            stroke="#6a5fc1"
            stroke-width="46"
            stroke-opacity="0.3"
            stroke-linecap="round"
          />

          <!-- Road Center Dashed Highway Line -->
          <path
            d="M 60,320 C 180,320 180,160 260,160 C 340,160 340,320 420,320 C 500,320 500,140 580,140 C 660,140 660,310 740,310 C 820,310 820,150 880,150 C 940,150 940,260 970,260"
            fill="none"
            stroke="#c2ef4e"
            stroke-width="3"
            stroke-dasharray="14,14"
            stroke-linecap="round"
            filter="url(#neonLimeGlow)"
          />
        </svg>

        <!-- Interactive Station Milestone Stop Pins -->
        {stations.map((st) => (
          <div
            class="station-pin absolute -translate-x-1/2 -translate-y-1/2 cursor-pointer group z-20 transition-transform duration-300 hover:scale-110"
            style={`left: ${st.x}%; top: ${st.y}%;`}
            data-id={st.id}
            data-x={st.x}
            data-y={st.y}
            data-angle={st.carAngle}
          >
            <!-- Pin Glow Ring -->
            <div class={`pin-ring w-10 h-10 sm:w-12 sm:h-12 rounded-full flex items-center justify-center border-2 transition-all duration-300 ${
              st.id === 1
                ? 'border-lime-neon bg-midnight-900 shadow-glow-lime scale-110'
                : 'border-violet-brand/70 bg-midnight-900/90 hover:border-lime-neon'
            }`}>
