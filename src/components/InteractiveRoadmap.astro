              {st.logo ? (
                <img src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}${st.logo}`} alt={st.title} class="w-5 h-5 object-contain rounded" />
              ) : (
                <span class="font-mono font-bold text-xs text-white">{st.id}</span>
              )}
            </div>

            <!-- Floating Label Tooltip on Road -->
            <div class="absolute top-12 left-1/2 -translate-x-1/2 whitespace-nowrap pointer-events-none flex flex-col items-center">
              <span class="px-2 py-0.5 rounded bg-midnight-900/95 border border-midnight-700 text-[10px] font-mono text-lime-neon font-bold shadow-md">
                {st.year}
              </span>
              <span class="text-[11px] font-bold text-white tracking-tight mt-0.5 drop-shadow">
                {st.title}
              </span>
            </div>
          </div>
