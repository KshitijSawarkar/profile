              <rect x="46" y="24" width="10" height="8" rx="3" fill="#0d0915" stroke="#c2ef4e" stroke-width="1.5" />
              
              <!-- Main Chassis -->
              <path d="M 4,22 L 14,14 L 26,10 L 46,10 L 58,16 L 62,24 L 54,26 L 10,26 Z" fill="#1f1633" stroke="#6a5fc1" stroke-width="2" />
              
