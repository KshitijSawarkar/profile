        <!-- THE ANIMATED CAR / CYBER-ROVER -->
        <div
          id="animated-car"
          class="absolute z-30 pointer-events-none transition-all duration-700 ease-out -translate-x-1/2 -translate-y-1/2"
          style="left: 10%; top: 80%; transform: translate(-50%, -50%) rotate(-15deg);"
        >
          <!-- Cyber Rover Car Body -->
          <div class="relative w-14 h-8 flex items-center justify-center">
            <!-- Neon Underglow -->
            <div class="absolute inset-0 bg-lime-neon rounded-full blur-md opacity-80 animate-pulse"></div>

            <!-- Car Vector SVG -->
            <svg class="w-full h-full relative z-10 drop-shadow-2xl" viewBox="0 0 64 36" fill="none">
