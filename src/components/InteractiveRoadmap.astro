  let currentStationId = 1;
  let tourInterval: any = null;

  const car = document.getElementById('animated-car');
  const stationPins = document.querySelectorAll('.station-pin');
  const activeStationNum = document.getElementById('active-station-num');

  // Details card elements
  const cardStationTag = document.getElementById('card-station-tag');
