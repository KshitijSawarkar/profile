  const tourBtnText = document.getElementById('tour-btn-text');

  function moveCarToStation(stationId: number) {
    const station = stationsData.find(s => s.id === stationId);
    if (!station) return;

    currentStationId = stationId;

    // 1. Move Car
    if (car) {
      car.style.left = `${station.x}%`;
      car.style.top = `${station.y}%`;
      car.style.transform = `translate(-50%, -50%) rotate(${station.carAngle}deg)`;
    }

    // 2. Update Station Pins styling
    stationPins.forEach(pin => {
      const id = parseInt(pin.getAttribute('data-id') || '0');
      const ring = pin.querySelector('.pin-ring');
      if (ring) {
        if (id === stationId) {
          ring.className = 'pin-ring w-10 h-10 sm:w-12 sm:h-12 rounded-full flex items-center justify-center border-2 transition-all duration-300 border-lime-neon bg-midnight-900 shadow-glow-lime scale-110';
        } else {
          ring.className = 'pin-ring w-10 h-10 sm:w-12 sm:h-12 rounded-full flex items-center justify-center border-2 transition-all duration-300 border-violet-brand/70 bg-midnight-900/90 hover:border-lime-neon';
        }
      }
    });

    // 3. Update Indicator
    if (activeStationNum) activeStationNum.textContent = stationId.toString();

    // 4. Update Details Card
    if (cardStationTag) cardStationTag.textContent = `Station ${station.id} of 7`;
    if (cardCategory) cardCategory.textContent = station.category;
    if (cardYear) cardYear.textContent = station.year;
    if (cardTitle) cardTitle.textContent = station.title;
    if (cardSubtitle) cardSubtitle.innerHTML = station.subtitle;
    if (cardHighlight) cardHighlight.textContent = station.highlight;

    if (cardBullets) {
      cardBullets.innerHTML = station.bulletPoints.map(point => `
        <li class="flex items-start gap-2 text-sm text-slate-300">
          <span class="w-1.5 h-1.5 rounded-full bg-lime-neon mt-2 shrink-0"></span>
          <span>${point}</span>
        </li>
      `).join('');
    }

    if (cardPills) {
      cardPills.innerHTML = station.techPills.map(pill => `
        <span class="px-2.5 py-0.5 rounded text-xs font-mono bg-midnight-900/80 border border-midnight-700 text-slate-300">${pill}</span>
      `).join('');
    }
  }

  // Hover & Click listeners on each station pin
  stationPins.forEach(pin => {
    // When cursor enters station
    pin.addEventListener('mouseenter', () => {
      stopAutoTour();
      const id = parseInt(pin.getAttribute('data-id') || '1');
      moveCarToStation(id);
    });

    pin.addEventListener('click', () => {
      stopAutoTour();
      const id = parseInt(pin.getAttribute('data-id') || '1');
      moveCarToStation(id);
    });
  });

  // Next / Prev button triggers
  btnNext?.addEventListener('click', () => {
    stopAutoTour();
    const nextId = currentStationId >= 7 ? 1 : currentStationId + 1;
    moveCarToStation(nextId);
  });

  btnPrev?.addEventListener('click', () => {
    stopAutoTour();
    const prevId = currentStationId <= 1 ? 7 : currentStationId - 1;
    moveCarToStation(prevId);
  });

  // Auto Tour logic
  function stopAutoTour() {
    if (tourInterval) {
      clearInterval(tourInterval);
      tourInterval = null;
      if (tourBtnText) tourBtnText.textContent = "Auto Drive Tour";
    }
  }

  btnAutoTour?.addEventListener('click', () => {
    if (tourInterval) {
      stopAutoTour();
    } else {
      if (tourBtnText) tourBtnText.textContent = "Stop Driving Tour";
      tourInterval = setInterval(() => {
        const nextId = currentStationId >= 7 ? 1 : currentStationId + 1;
        moveCarToStation(nextId);
      }, 2800);
    }
  });
</script>
