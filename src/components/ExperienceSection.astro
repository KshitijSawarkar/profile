---
export interface ExperienceItem {
  company: string;
  role: string;
  location: string;
  period: string;
  category: string;
  logo?: string;
  isCurrent?: boolean;
  deployments?: { label: string; url?: string }[];
  bulletPoints: string[];
  tags: string[];
}

const experiences: ExperienceItem[] = [
  {
    company: "Wakefit Innovations Ltd",
    role: "Systems & Automation Engineering Intern (Intern-PGET)",
    location: "Bengaluru & Bommasandra Manufacturing Facility",
    period: "Aug 2026 – Present",
    category: "Industrial Manufacturing Operations",
    isCurrent: true,
    deployments: [
      { label: "npl-automation.pages.dev", url: "https://npl-automation.pages.dev" },
      { label: "image-sequence-renamer.pages.dev", url: "https://image-sequence-renamer.pages.dev" },
      { label: "Wakefit Repair Calculator", url: "https://kshitijsawarkar.github.io/Wakefit_Repair_Calculator/" }
    ],
    bulletPoints: [
      "Embedded on-site into high-throughput manufacturing operations to diagnose and resolve systemic bottlenecks between physical floor teams and enterprise cataloging databases.",
      "Architected and deployed customer-grade Finished Goods & BOM Schema Transformation Engine (https://npl-automation.pages.dev/), cutting multi-day operational backlogs into an automated validation pipeline executing in <50ms with 100% data privacy.",
      "Shipped client-side Batch Asset Ingestion Engine (https://image-sequence-renamer.pages.dev/), reducing asset onboarding latency by >80% with zero server overhead.",
      "Engineered the Deterministic Repair Cost Engine (Wakefit Repair Calculator: https://kshitijsawarkar.github.io/Wakefit_Repair_Calculator/), implementing defensive pricing constraints to eliminate margin loss from manual human calculation drift."
    ],
    tags: ["On-Site Systems Deployment", "Sub-50ms Engine", "BOM Schema Transformation", "Floor Automation", "Zero-Compute Client Processing"]
  },
  {
    company: "Motilal Nehru National Institute of Technology (MNNIT) Allahabad",
    role: "Graduate Teaching Assistant (M.Tech Control & Instrumentation)",
    location: "Prayagraj, India",
    period: "Aug 2025 – Present",
    category: "Department of Electrical Engineering",
    logo: "/images/mnnit-logo.png",
    isCurrent: true,
    bulletPoints: [
      "Graduate Teaching Assistant in Control Systems & Instrumentation. Led hands-on laboratory sessions and tutorials for 100+ undergraduate engineering students.",
      "Guided students in closed-loop state feedback design, mathematical stability analysis, benchtop sensor troubleshooting, and Hardware-in-the-Loop (HIL) calibration rigs."
    ],
    tags: ["Control Systems", "State-Space Modeling", "HIL Calibration", "Sensor Troubleshooting", "Academic Rigor"]
  },
  {
    company: "Sharon Innovations (RCOEM TBI Foundation)",
    role: "IoT & Embedded Systems Intern",
    location: "Nagpur, India",
    period: "Dec 2023 – Feb 2024",
    category: "Technology Business Incubator",
    logo: "/images/rcoem-logo.png",
    bulletPoints: [
      "Integrated physical ESP32 and Arduino Uno microcontroller sensor nodes with environmental telemetry sensors, establishing low-power wireless transmission pipelines.",
      "Calibrated analog-to-digital (ADC) sensor conversions and debugged bus communication protocols (I2C, SPI, UART) for physical prototype testing."
    ],
    tags: ["ESP32", "Arduino Uno", "I2C / SPI / UART", "Sensor Calibration"]
  },
  {
    company: "All India Council for Technical Education (AICTE)",
    role: "Cloud Infrastructure & MLOps Intern",
    location: "Remote, India",
    period: "May 2023 – Jul 2023",
    category: "AWS Cloud Infrastructure Program",
    bulletPoints: [
      "Architected event-driven serverless data ingestion pipelines using AWS S3 bucket triggers and AWS Lambda functions, achieving ~99.9% uptime.",
      "Deployed and monitored machine learning model endpoints using Amazon SageMaker (XGBoost, Linear Learner) with optimized compute allocation across EC2 and S3 storage tiers."
    ],
    tags: ["AWS Lambda", "Amazon SageMaker", "AWS S3", "MLOps Pipelines"]
  }
];
---

<section id="experience" class="py-16 md:py-20 border-t border-midnight-600/50">
  <div class="max-w-5xl mx-auto px-4 sm:px-6">
    <!-- Header -->
    <div class="mb-10">
      <div class="text-xs font-mono text-lime-neon uppercase tracking-wider mb-2">
        01 / FORMAL ENGINEERING EXPERIENCE
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white font-display">
        Engineering & Institutional Roles
      </h2>
      <p class="text-slate-400 mt-2 text-base">
        Translating operational friction and control systems theory into deterministic software, hardware telemetry, and automated production pipelines.
      </p>
    </div>

    <!-- Timeline List -->
    <div class="space-y-6">
      {experiences.map((exp) => (
        <div class="glass-panel p-6 sm:p-7 rounded-2xl border border-midnight-600/80 hover:border-violet-brand/60 transition-all">
          <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-4 mb-4">
            <div class="flex items-start gap-4">
              {exp.logo && (
                <div class="w-11 h-11 rounded-lg bg-white/95 p-1 flex items-center justify-center shadow border border-white/20 shrink-0 hidden sm:flex">
                  <img
                    src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}${exp.logo}`}
                    alt={`${exp.company} Logo`}
                    class="max-w-full max-h-full object-contain"
                    loading="lazy"
                  />
                </div>
              )}
              <div>
                <div class="flex flex-wrap items-center gap-2 mb-1.5">
                  {exp.isCurrent && (
                    <span class="px-2 py-0.5 rounded text-[11px] font-mono font-semibold bg-lime-neon/15 text-lime-neon border border-lime-neon/30">
                      Active Role
                    </span>
                  )}
                  <span class="text-xs font-mono text-violet-300">
                    {exp.category}
                  </span>
                </div>

                <h3 class="text-lg sm:text-xl font-bold text-white">
                  {exp.role}
                </h3>
                <p class="text-sm font-medium text-slate-300 mt-0.5">
                  {exp.company} &bull; <span class="text-slate-400 text-xs">{exp.location}</span>
                </p>
              </div>
            </div>

            <div class="font-mono text-xs text-slate-400 shrink-0">
              {exp.period}
            </div>
          </div>

          <!-- Live Deployments Bar if available -->
          {exp.deployments && exp.deployments.length > 0 && (
            <div class="mb-4 p-3 rounded-xl bg-midnight-900/90 border border-midnight-700 flex flex-wrap items-center gap-2">
              <span class="text-xs font-mono text-lime-neon font-semibold flex items-center gap-1">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
                Live Deployments:
              </span>
              {exp.deployments.map(dep => (
                dep.url ? (
                  <a
                    href={dep.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="px-2.5 py-1 rounded bg-violet-deep/60 hover:bg-violet-brand/80 border border-violet-brand/50 text-xs font-mono text-white transition-colors flex items-center gap-1"
                  >
                    <span>{dep.label}</span>
                    <svg class="w-3 h-3 text-lime-neon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                    </svg>
                  </a>
                ) : (
                  <span class="px-2.5 py-1 rounded bg-midnight-800 border border-midnight-600 text-xs font-mono text-slate-300">
                    {dep.label}
                  </span>
                )
              ))}
            </div>
          )}

          <!-- Bullet Points -->
          <ul class="space-y-2 mb-5">
            {exp.bulletPoints.map(point => (
              <li class="flex items-start gap-2.5 text-sm text-slate-300 leading-relaxed">
                <span class="w-1.5 h-1.5 rounded-full bg-lime-neon mt-2 shrink-0"></span>
                <span>{point}</span>
              </li>
            ))}
          </ul>

          <!-- Tags -->
          <div class="flex flex-wrap gap-1.5 pt-3 border-t border-midnight-600/40">
            {exp.tags.map(tag => (
              <span class="px-2 py-0.5 rounded text-xs font-mono bg-midnight-900/60 border border-midnight-700 text-slate-400">
                {tag}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
