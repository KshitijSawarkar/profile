---

<section id="projects" class="py-16 md:py-20 border-t border-midnight-600/50">
  <div class="max-w-5xl mx-auto px-4 sm:px-6">
    <!-- Header -->
    <div class="mb-10">
      <div class="text-xs font-mono text-lime-neon uppercase tracking-wider mb-2">
        02 / RESEARCH & SOVEREIGN VENTURES
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white font-display">
        Peer-Reviewed Research & Systems
      </h2>
      <p class="text-slate-400 mt-2 text-base">
        Selected peer-reviewed IEEE publications, sovereign web platforms, and physical autonomous robotics systems.
      </p>
    </div>

    <!-- Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {projects.map(proj => (
        <div class={`glass-panel p-6 sm:p-7 rounded-2xl border ${proj.featured ? 'border-lime-neon/50 md:col-span-2' : 'border-midnight-600/80'} hover:border-violet-brand/60 transition-all flex flex-col justify-between group`}>
          <div>
            <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
              <span class={`px-2.5 py-0.5 rounded text-xs font-mono font-semibold border ${proj.badgeColor}`}>
                {proj.badge}
              </span>
              <span class="text-xs font-mono text-slate-400">
                {proj.date}
              </span>
            </div>

            <h3 class="text-xl font-bold text-white group-hover:text-lime-neon transition-colors mb-1.5">
              {proj.title}
            </h3>

            {proj.docId && (
              <div class="text-xs font-mono text-lime-neon mb-3 font-semibold">
                {proj.docId} &bull; Published Lead Author
              </div>
            )}

            {proj.liveUrl && (
              <a
                href={proj.liveUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1 text-xs font-mono text-lime-neon hover:underline mb-3"
              >
                <span>Live Platform: {proj.liveUrl.replace('https://', '')}</span>
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </a>
            )}

            <p class="text-sm text-slate-300 leading-relaxed mb-5">
              {proj.description}
            </p>

            <!-- Metrics -->
            <div class="space-y-1.5 mb-6 p-3.5 rounded-xl bg-midnight-900/80 border border-midnight-700 font-mono text-xs">
              {proj.metrics.map(metric => (
                <div class="flex items-center gap-2 text-slate-200">
                  <span class="w-1.5 h-1.5 rounded-full bg-lime-neon shrink-0"></span>
                  <span>{metric}</span>
                </div>
              ))}
            </div>
          </div>

          <!-- Tags -->
          <div class="flex flex-wrap gap-1.5 pt-4 border-t border-midnight-600/50">
            {proj.techStack.map(tag => (
              <span class="px-2.5 py-0.5 rounded text-xs font-mono bg-midnight-900/60 border border-midnight-700 text-slate-300">
                {tag}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
