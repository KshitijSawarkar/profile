---
export interface ProjectItem {
  title: string;
  badge: string;
  badgeColor: string;
  role: string;
  date: string;
  docId?: string;
  liveUrl?: string;
  description: string;
  metrics: string[];
  techStack: string[];
  featured?: boolean;
}

const projects: ProjectItem[] = [
  {
    title: "Automated Edge Vision & Retail Checkout System",
    badge: "IEEE Xplore Peer-Reviewed Research",
    badgeColor: "bg-lime-neon/15 text-lime-neon border-lime-neon/40",
    role: "Published Lead Author",
    date: "Published Mar 2026",
    docId: "IEEE Doc ID: 10627276",
    featured: true,
    description: "Architected an automated item detection and billing pipeline using custom YOLOv5 models deployed directly onto physical ARM-based Raspberry Pi hardware. Implemented Post-Training Quantization (INT8) via ONNX Runtime to balance activation scales, preserving <1% mAP loss while enabling sub-second inference (24.6ms) without expensive cloud GPUs.",
    metrics: [
      "<1% mAP loss with INT8 Quantization",
      "Sub-second ARM edge inference (24.6ms)",
      "Zero reliance on cloud GPUs"
    ],
    techStack: ["IEEE Xplore", "YOLOv5", "ONNX Runtime", "INT8 Quantization", "Raspberry Pi", "ARM Edge"]
  },
  {
    title: "cardsfinders.com — Sovereign Edge Financial Tools",
    badge: "Sovereign Venture & Edge Architecture",
    badgeColor: "bg-violet-300/15 text-violet-300 border-violet-brand/40",
    role: "Founder & Full-Stack Edge Systems Architect",
    date: "Jul 2026 – Present",
    liveUrl: "https://cardsfinders.com",
    description: "Conceived, architected, and deployed a global financial tools comparison platform hosted entirely on Cloudflare Pages and Workers. Engineered custom edge DNS configurations, Cloudflare email routing rules, and sub-second Time-to-First-Byte (TTFB) delivery pipelines with zero server runtime compute cost.",
    metrics: [
      "Sub-second TTFB global edge delivery",
      "Top-tier Core Web Vitals & modern SEO",
      "Zero server runtime compute overhead"
    ],
    techStack: ["Cloudflare Pages", "Cloudflare Workers", "Edge DNS", "Serverless", "Modern SEO"]
  },
  {
    title: "myuselessweb.com — High-Traffic Edge Discovery",
    badge: "Interactive Edge Experiment",
    badgeColor: "bg-pink-neon/15 text-pink-neon border-pink-neon/40",
    role: "Creator & Edge Infrastructure Engineer",
    date: "Jan 2024 – Present",
    liveUrl: "https://myuselessweb.com",
    description: "Built and deployed an ultra-minimalist, high-traffic interactive web discovery platform deployed over Cloudflare edge infrastructure. Optimized DOM rendering cycles and assets to guarantee near-instantaneous global edge delivery (<50ms) across all devices.",
    metrics: [
      "<50ms global latency over Cloudflare edge",
      "Optimized DOM rendering cycles",
      "High-traffic viral structural architecture"
    ],
    techStack: ["Edge Infrastructure", "Ultra-Low Latency", "DOM Optimization", "Interactive Web"]
  },
  {
    title: "HiWonder MentorPi M1 Autonomous Mobile Robot",
    badge: "Robotics & Autonomous Navigation",
    badgeColor: "bg-lime-neon/15 text-lime-neon border-lime-neon/40",
    role: "Robotics & Autonomous Systems Engineer",
    date: "Jul 2026",
    description: "Assembled, flashed, and configured the HiWonder MentorPi M1 mobile robot running on a Raspberry Pi 5 under Robot Operating System 2 (ROS2). Integrated monocular camera vision perception, battery power management, and SLAM navigation algorithms for autonomous indoor path planning.",
    metrics: [
      "Full ROS2 stack on Raspberry Pi 5",
      "SLAM indoor mapping & autonomous path planning",
      "Real-time monocular vision perception"
    ],
    techStack: ["ROS2", "Raspberry Pi 5", "SLAM Navigation", "Mobile Robotics", "Computer Vision"]
  },
  {
    title: "Sensorless Solar Photovoltaic Tracking System",
    badge: "Autonomous Control Systems",
    badgeColor: "bg-violet-300/15 text-violet-300 border-violet-brand/40",
    role: "Hardware & Control Systems Designer",
    date: "Mar 2026",
    description: "Invented a closed-loop solar tracking mechanism using the photovoltaic output voltage of the solar panels themselves to detect light gradients, completely eliminating external light-dependent resistors (LDRs). Programmed microcontroller actuation algorithms driving servo motors toward peak power points.",
    metrics: [
      "Completely eliminated external LDR sensors",
      "Direct differential PV gradient sensing",
      "Closed-loop servo actuation toward peak yield"
    ],
    techStack: ["Microcontroller C++", "Closed-Loop Control", "Photovoltaic Physics", "Servo Actuation"]
