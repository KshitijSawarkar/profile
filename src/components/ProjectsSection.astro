---
export interface ProjectItem {
  title: string;
  badge: string;
  badgeColor: string;
  role: string;
  date: string;
  docId?: string;
  liveUrl?: string;
  description: string;
  metrics: string[];
  techStack: string[];
  featured?: boolean;
}

const projects: ProjectItem[] = [
  {
    title: "Automated Edge Vision & Retail Checkout System using Quantized YOLOv5 on Embedded Hardware",
    badge: "Peer-Reviewed Research & Edge Benchmarks",
    badgeColor: "bg-lime-neon/15 text-lime-neon border-lime-neon/40",
    role: "Lead Author",
    date: "IEEE Xplore | Document ID: 10627276",
    docId: "IEEE Xplore | Document ID: 10627276",
    featured: true,
    description: "Lead author; implemented INT8 Post-Training Quantization via ONNX Runtime to balance activation dynamic ranges on ARM/Raspberry Pi hardware, preserving <1% mAP degradation while delivering sub-second inference (24.6ms) without expensive cloud GPUs.",
    metrics: [
      "<1% mAP degradation with INT8 Post-Training Quantization",
      "Sub-second ARM edge inference (24.6ms latency)",
      "Zero reliance on expensive cloud GPUs for retail edge checkout"
    ],
    techStack: ["IEEE Xplore (Doc ID: 10627276)", "YOLOv5", "ONNX Runtime", "INT8 Quantization", "Raspberry Pi", "ARM Edge"]
  },
  {
    title: "HiWonder MentorPi M1 Autonomous Mobile Robot (ROS2)",
    badge: "Physical Autonomous Robotics",
    badgeColor: "bg-lime-neon/15 text-lime-neon border-lime-neon/40",
    role: "Robotics & Autonomous Systems Engineer",
    date: "Platform: Raspberry Pi 5 under ROS2",
    featured: false,
    description: "Assembled chassis, flashed real-time system images, configured battery management, and integrated monocular camera vision pipelines for autonomous SLAM navigation and obstacle avoidance.",
    metrics: [
      "Full ROS2 stack running on Raspberry Pi 5",
      "Autonomous SLAM indoor mapping & path planning",
      "Monocular camera vision pipeline for obstacle avoidance"
    ],
    techStack: ["ROS2", "Raspberry Pi 5", "SLAM Navigation", "Mobile Robotics (AMR)", "Computer Vision"]
  },
  {
    title: "Sensorless Solar Photovoltaic Tracking System",
    badge: "Autonomous Control & Hardware",
    badgeColor: "bg-violet-300/15 text-violet-300 border-violet-brand/40",
    role: "Hardware & Control Systems Designer",
    date: "Closed-Loop State Actuation",
    featured: false,
    description: "Built a closed-loop tracking mechanism utilizing the photovoltaic output voltage of the solar panels themselves to detect light intensity, eliminating fragile external sensors (LDRs) and reducing physical points of failure.",
    metrics: [
      "100% eliminated fragile external sensors (LDRs)",
      "Direct differential PV voltage gradient sensing",
      "Closed-loop servo actuation to maintain peak power point"
    ],
    techStack: ["Closed-Loop Control", "Microcontroller C++", "Photovoltaic Physics", "Servo Actuation", "Hardware Calibration"]
  },
  {
    title: "cardsfinders.com — Sovereign Edge Financial Tools",
    badge: "Sovereign Edge Infrastructure",
    badgeColor: "bg-violet-300/15 text-violet-300 border-violet-brand/40",
    role: "Founder & Full-Stack Edge Systems Architect",
    date: "Jul 2026 – Present",
    liveUrl: "https://cardsfinders.com",
    description: "Conceived, architected, and deployed a global financial tools comparison platform hosted entirely on Cloudflare Pages and Workers. Engineered custom edge DNS configurations, Cloudflare email routing rules, and sub-second Time-to-First-Byte (TTFB) delivery pipelines with zero server runtime compute cost.",
    metrics: [
      "Sub-second TTFB global edge delivery",
      "Zero server runtime compute overhead",
      "Edge DNS & automated Cloudflare routing"
    ],
    techStack: ["Cloudflare Pages", "Cloudflare Workers", "Edge DNS", "Serverless Edge", "TypeScript"]
  },
  {
    title: "myuselessweb.com — High-Traffic Edge Discovery",
    badge: "Interactive Edge Experiment",
    badgeColor: "bg-pink-neon/15 text-pink-neon border-pink-neon/40",
    role: "Creator & Edge Infrastructure Engineer",
    date: "Jan 2024 – Present",
    liveUrl: "https://myuselessweb.com",
    description: "Built and deployed an ultra-minimalist, high-traffic interactive web discovery platform deployed over Cloudflare edge infrastructure. Optimized DOM rendering cycles and assets to guarantee near-instantaneous global edge delivery (<50ms) across all devices.",
    metrics: [
      "<50ms global latency over Cloudflare edge",
      "Optimized DOM rendering cycles",
      "High-traffic viral structural architecture"
    ],
    techStack: ["Edge Infrastructure", "Ultra-Low Latency", "DOM Optimization", "Interactive Web"]
  }
];
---

<section id="projects" class="py-16 md:py-20 border-t border-midnight-600/50">
  <div class="max-w-5xl mx-auto px-4 sm:px-6">
    <!-- Header -->
    <div class="mb-10">
      <div class="text-xs font-mono text-lime-neon uppercase tracking-wider mb-2">
        02 / PEER-REVIEWED RESEARCH & PHYSICAL ARTIFACTS
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white font-display">
        Peer-Reviewed Research & Physical Systems
      </h2>
      <p class="text-slate-400 mt-2 text-base">
        Lead-author IEEE edge neural network research, physical ROS2 mobile robotics artifacts, and sovereign edge infrastructure.
      </p>
    </div>

    <!-- Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {projects.map(proj => (
        <div class={`glass-panel p-6 sm:p-7 rounded-2xl border ${proj.featured ? 'border-lime-neon/50 md:col-span-2' : 'border-midnight-600/80'} hover:border-violet-brand/60 transition-all flex flex-col justify-between group`}>
          <div>
            <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
              <span class={`px-2.5 py-0.5 rounded text-xs font-mono font-semibold border ${proj.badgeColor}`}>
                {proj.badge}
              </span>
              <span class="text-xs font-mono text-slate-400">
                {proj.date}
              </span>
            </div>

            <h3 class="text-xl font-bold text-white group-hover:text-lime-neon transition-colors mb-1.5">
              {proj.title}
            </h3>

            {proj.docId && (
              <div class="text-xs font-mono text-lime-neon mb-3 font-semibold">
                {proj.docId} &bull; Published Lead Author
              </div>
            )}

            {proj.liveUrl && (
              <a
                href={proj.liveUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1 text-xs font-mono text-lime-neon hover:underline mb-3"
              >
                <span>Live Platform: {proj.liveUrl.replace('https://', '')}</span>
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </a>
            )}

            <p class="text-sm text-slate-300 leading-relaxed mb-5">
              {proj.description}
            </p>

            <!-- Metrics -->
            <div class="space-y-1.5 mb-6 p-3.5 rounded-xl bg-midnight-900/80 border border-midnight-700 font-mono text-xs">
              {proj.metrics.map(metric => (
                <div class="flex items-center gap-2 text-slate-200">
                  <span class="w-1.5 h-1.5 rounded-full bg-lime-neon shrink-0"></span>
                  <span>{metric}</span>
                </div>
              ))}
            </div>
          </div>

          <!-- Tags -->
          <div class="flex flex-wrap gap-1.5 pt-4 border-t border-midnight-600/50">
            {proj.techStack.map(tag => (
              <span class="px-2.5 py-0.5 rounded text-xs font-mono bg-midnight-900/60 border border-midnight-700 text-slate-300">
                {tag}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
