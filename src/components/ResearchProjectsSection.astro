---
export interface ResearchProject {
  id: string;
  title: string;
  badge: string;
  badgeColor: string;
  category: string;
  filterCategory: 'all' | 'edge-ai' | 'agents' | 'robotics' | 'cleantech';
  role: string;
  date: string;
  docId?: string;
  bibtex?: string;
  description: string[];
  keyHighlights: string[];
  techStack: string[];
  featured?: boolean;
}

const projects: ResearchProject[] = [
  {
    id: "proj-ieee",
    title: "Automated Edge Vision & Retail Checkout System",
    badge: "IEEE Xplore Published Lead Author",
    badgeColor: "bg-lime-neon/15 text-lime-neon border-lime-neon/40",
    category: "Embedded Edge AI & Computer Vision",
    filterCategory: "edge-ai",
    role: "Published Lead Author",
    date: "Published Mar 2026",
    docId: "IEEE Doc ID: 10627276",
    bibtex: `@article{sawarkar2026automated,
  title={Automated Edge Vision & Retail Checkout System},
  author={Sawarkar, Kshitij Ashok},
  journal={IEEE Xplore},
  year={2026},
  doi={10.1109/IEEEDocID.10627276}
}`,
    featured: true,
    description: [
      "Architected an automated item detection and billing pipeline using custom YOLOv5 models deployed directly onto ARM-based Raspberry Pi hardware.",
      "Implemented Post-Training Quantization (INT8) via ONNX Runtime to balance activation scales, preserving <1% mAP loss while enabling sub-second inference without expensive cloud GPUs."
    ],
    keyHighlights: [
      "<1% mAP loss with INT8 Quantization",
      "Sub-second ARM edge inference (24.6ms)",
      "Custom YOLOv5 pipeline on Raspberry Pi",
      "Zero reliance on expensive cloud GPUs"
    ],
    techStack: ["IEEE Xplore", "YOLOv5", "ONNX Runtime", "INT8 Quantization", "Raspberry Pi", "ARM Edge", "Computer Vision"]
  },
  {
    id: "proj-agents",
    title: "Deterministic Multi-Agent Fleet & Dynamic Failover Routing",
    badge: "Autonomous Agent Orchestration",
    badgeColor: "bg-violet-300/15 text-violet-300 border-violet-brand/40",
    category: "Applied AI Systems Architecture",
    filterCategory: "agents",
    role: "Applied AI Systems Architect",
    date: "2026",
    description: [
      "Engineered an autonomous dual-agent pipeline (Agent 1 Scout & Agent 2 LaTeX Tailor) governed by strict boundary contracts codified in AGENTS.md.",
      "Implemented dynamic multi-tier failover routing (Google Gemini Flash → Groq API → Local LLMs) with Pydantic v2 guardrails and Telegram webhook telemetry."
    ],
    keyHighlights: [
      "Multi-tier failover (Gemini Flash → Groq → Local)",
      "Strict AGENTS.md contract governance",
      "Pydantic v2 runtime data validation",
      "Real-time Telegram webhook telemetry"
    ],
    techStack: ["Multi-Agent AI", "Gemini Flash", "Groq API", "Pydantic v2", "Telegram Webhooks", "State Machines"]
  },
  {
    id: "proj-solar",
    title: "Sensorless Solar Photovoltaic Tracking System",
    badge: "Clean Tech & Autonomous Control",
    badgeColor: "bg-pink-neon/15 text-pink-neon border-pink-neon/40",
    category: "Hardware & Embedded Systems",
    filterCategory: "cleantech",
    role: "Hardware & Embedded Systems Designer",
    date: "Mar 2026",
    description: [
      "Invented a closed-loop solar tracking mechanism using the photovoltaic output voltage of the solar panels themselves to detect light gradients, completely eliminating external light-dependent resistors (LDRs).",
      "Programmed microcontroller actuation algorithms to drive servo motors toward peak power points, optimizing energy harvesting efficiency."
    ],
    keyHighlights: [
      "Eliminated external LDR sensors entirely",
      "Direct PV differential voltage gradient sensing",
      "Closed-loop servo actuation algorithms",
      "Optimized solar energy harvesting yield"
    ],
    techStack: ["Microcontroller C++", "Closed-Loop Control", "Photovoltaic Physics", "Servo Actuation", "Clean Tech"]
  },
  {
    id: "proj-robotics",
    title: "HiWonder MentorPi M1 Autonomous Mobile Robot (ROS2)",
    badge: "Mobile Robotics & Autonomous Navigation",
    badgeColor: "bg-lime-neon/15 text-lime-neon border-lime-neon/40",
    category: "Robotics Platform",
    filterCategory: "robotics",
    role: "Robotics & Autonomous Navigation Engineer",
    date: "Jul 2026",
    description: [
      "Assembled, flashed, and configured the HiWonder MentorPi M1 mobile robot running on a Raspberry Pi 5 under Robot Operating System 2 (ROS2).",
      "Integrated monocular camera vision pipelines, battery power management, and SLAM navigation algorithms for autonomous indoor path planning."
    ],
    keyHighlights: [
      "ROS2 deployment on Raspberry Pi 5",
      "SLAM indoor navigation & path planning",
      "Monocular vision perception pipeline",
      "Hardware battery power management"
    ],
    techStack: ["ROS2", "Raspberry Pi 5", "SLAM Navigation", "Monocular Vision", "Autonomous Mobile Robotics"]
  },
  {
    id: "proj-telemetry",
    title: "Wokwi Arduino Gas Detection Telemetry System",
    badge: "Safety & Sensor Telemetry",
    badgeColor: "bg-violet-300/15 text-violet-300 border-violet-brand/40",
    category: "Embedded Simulation",
    filterCategory: "cleantech",
    role: "Embedded Systems Developer",
    date: "Dec 2025",
    description: [
      "Built a live, fully verified digital simulation of an automated gas leakage detection and alarm system using Arduino Uno and MQ-2 gas sensors on Wokwi.",
      "Programmed threshold-triggered interrupt routines, audible buzzer alarms, and real-time visual status updates."
    ],
    keyHighlights: [
      "Interrupt-driven alarm routines",
      "MQ-2 gas concentration calibration",
      "Wokwi simulation verification",
      "Visual + audio telemetry alerting"
    ],
    techStack: ["Arduino C++", "MQ-2 Gas Sensor", "Wokwi Simulation", "Hardware Interrupts", "Safety Telemetry"]
  }
];
---

<section id="research-projects" class="py-16 md:py-24 relative">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="mb-10 flex flex-col md:flex-row md:items-end justify-between gap-6">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-violet-deep/60 border border-violet-brand/40 text-xs font-mono text-lime-neon mb-3">
          <span class="w-2 h-2 rounded-full bg-lime-neon"></span>
          RESEARCH & ROBOTICS
        </div>
        <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-white font-display">
          Research Publications, Applied AI & Robotics
        </h2>
        <p class="text-midnight-200 mt-2 max-w-2xl text-base">
          Peer-reviewed research and applied engineering systems across Edge AI quantization, autonomous multi-agent state machines, ROS2 robotics, and sensorless control.
        </p>
      </div>

      <!-- Filter Bar -->
      <div class="flex flex-wrap items-center gap-2 font-mono text-xs">
        <button class="proj-filter px-3 py-1.5 rounded-lg bg-lime-neon text-midnight-950 font-bold transition-all shadow-glow-lime" data-filter="all">
          All (5)
        </button>
        <button class="proj-filter px-3 py-1.5 rounded-lg bg-midnight-900 border border-midnight-700 text-slate-300 hover:text-white transition-all" data-filter="edge-ai">
          Edge AI
        </button>
        <button class="proj-filter px-3 py-1.5 rounded-lg bg-midnight-900 border border-midnight-700 text-slate-300 hover:text-white transition-all" data-filter="agents">
          Agent Systems
        </button>
        <button class="proj-filter px-3 py-1.5 rounded-lg bg-midnight-900 border border-midnight-700 text-slate-300 hover:text-white transition-all" data-filter="robotics">
          ROS2 Robotics
        </button>
        <button class="proj-filter px-3 py-1.5 rounded-lg bg-midnight-900 border border-midnight-700 text-slate-300 hover:text-white transition-all" data-filter="cleantech">
          Control & CleanTech
        </button>
      </div>
    </div>

    <!-- Grid -->
    <div id="projects-grid" class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      {projects.map((proj) => (
        <div 
          class={`project-card glass-panel p-6 sm:p-8 rounded-2xl border ${proj.featured ? 'border-lime-neon/40 lg:col-span-2' : 'border-midnight-600/70'} hover:border-violet-brand/60 transition-all duration-300 relative group overflow-hidden shadow-card-glow hover:shadow-glow-violet`}
          data-category={proj.filterCategory}
        >
          <!-- Subtle corner highlight -->
          <div class="absolute top-0 right-0 w-64 h-64 bg-gradient-to-bl from-violet-brand/15 via-lime-neon/5 to-transparent blur-2xl pointer-events-none -z-10"></div>

          <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-3 mb-4">
            <div>
              <div class="flex flex-wrap items-center gap-2 mb-2">
                <span class={`px-2.5 py-0.5 rounded text-xs font-mono font-semibold border ${proj.badgeColor}`}>
                  {proj.badge}
                </span>
                {proj.docId && (
                  <span class="px-2.5 py-0.5 rounded text-xs font-mono font-semibold bg-midnight-800 text-lime-neon border border-midnight-600">
                    {proj.docId}
                  </span>
                )}
                <span class="text-xs font-mono text-slate-400">
                  {proj.date}
                </span>
              </div>

              <h3 class="text-xl sm:text-2xl font-bold text-white group-hover:text-lime-neon transition-colors">
                {proj.title}
              </h3>
              <p class="text-xs font-mono text-violet-300 mt-1">
                {proj.role} &bull; {proj.category}
              </p>
            </div>

            <!-- BibTeX copy button if available -->
            {proj.bibtex && (
              <button
                class="copy-bibtex-btn px-3 py-1.5 rounded-lg bg-midnight-800/90 hover:bg-violet-deep border border-midnight-600 hover:border-lime-neon/60 text-xs font-mono text-slate-300 hover:text-white transition-all flex items-center gap-1.5 shrink-0 self-start"
                data-bibtex={proj.bibtex}
              >
                <svg class="w-3.5 h-3.5 text-lime-neon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" />
                </svg>
                <span>Copy BibTeX</span>
              </button>
            )}
          </div>

          <!-- Descriptions -->
          <div class="space-y-2 mb-6">
            {proj.description.map(desc => (
              <p class="text-sm text-slate-300 leading-relaxed">
                {desc}
              </p>
            ))}
          </div>

          <!-- Key Highlights Box -->
          <div class="mb-6 p-4 rounded-xl bg-midnight-900/80 border border-midnight-700">
            <div class="text-xs font-mono text-slate-400 uppercase tracking-wider mb-2 flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5 text-lime-neon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
              Key Technical Milestones
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
              {proj.keyHighlights.map(highlight => (
                <div class="flex items-center gap-2 text-xs font-mono text-slate-200">
                  <span class="w-1.5 h-1.5 rounded-full bg-lime-neon shrink-0"></span>
                  <span>{highlight}</span>
                </div>
              ))}
            </div>
          </div>

          <!-- Tech Stack Tags -->
          <div class="flex flex-wrap gap-2 pt-4 border-t border-midnight-600/50">
            {proj.techStack.map(tag => (
              <span class="px-2.5 py-1 rounded-md text-xs font-mono bg-midnight-900/60 border border-midnight-700 text-slate-300 hover:border-lime-neon/40 hover:text-white transition-colors">
                {tag}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  // Project Filter Logic
  const filterBtns = document.querySelectorAll('.proj-filter');
  const projectCards = document.querySelectorAll('.project-card');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const filter = btn.getAttribute('data-filter');

      filterBtns.forEach(b => {
        b.classList.remove('bg-lime-neon', 'text-midnight-950', 'font-bold', 'shadow-glow-lime');
        b.classList.add('bg-midnight-900', 'text-slate-300', 'border-midnight-700');
      });

      btn.classList.add('bg-lime-neon', 'text-midnight-950', 'font-bold', 'shadow-glow-lime');
      btn.classList.remove('bg-midnight-900', 'text-slate-300', 'border-midnight-700');

      projectCards.forEach(card => {
        const cat = card.getAttribute('data-category');
        if (filter === 'all' || cat === filter) {
          (card as HTMLElement).style.display = 'block';
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });
    });
  });

  // Copy BibTeX citation listener
  document.querySelectorAll('.copy-bibtex-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const bibtex = btn.getAttribute('data-bibtex');
      if (bibtex) {
        navigator.clipboard.writeText(bibtex).then(() => {
          if ((window as any).showToast) {
            (window as any).showToast("IEEE BibTeX Citation copied!");
          }
        });
      }
    });
  });
</script>
