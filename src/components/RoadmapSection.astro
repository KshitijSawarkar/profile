<section class="py-16 md:py-20 border-t border-midnight-600/50 bg-midnight-950/40">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="p-8 rounded-2xl glass-panel border border-violet-brand/30 relative overflow-hidden">
      <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-lime-neon/10 border border-lime-neon/30 text-xs font-mono text-lime-neon mb-3">
            <span class="w-2 h-2 rounded-full bg-lime-neon animate-ping"></span>
            STEP_BY_STEP_PROGRESS
          </div>
          <h3 class="text-2xl font-bold text-white font-display">
            Next Steps in Profile Construction
          </h3>
          <p class="text-sm text-midnight-200 mt-1 max-w-xl">
            We've set up the core design foundation and your Education section. As you provide your Experience, Skills, Certifications, and Project details, they will be seamlessly integrated here.
          </p>
        </div>

        <div class="grid grid-cols-2 gap-3 w-full md:w-auto font-mono text-xs">
          <div class="px-4 py-3 rounded-xl bg-midnight-900/90 border border-lime-neon/40 text-lime-neon flex items-center gap-2">
            <svg class="w-4 h-4 text-lime-neon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span>1. Education</span>
          </div>
          <div class="px-4 py-3 rounded-xl bg-midnight-900/60 border border-midnight-600/60 text-slate-400 flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-violet-brand"></span>
            <span>2. Experience</span>
          </div>
          <div class="px-4 py-3 rounded-xl bg-midnight-900/60 border border-midnight-600/60 text-slate-400 flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-violet-brand"></span>
            <span>3. Skills Matrix</span>
          </div>
          <div class="px-4 py-3 rounded-xl bg-midnight-900/60 border border-midnight-600/60 text-slate-400 flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-violet-brand"></span>
            <span>4. Certificates</span>
          </div>
        </div>
      </div>
    </div>
  </div>
